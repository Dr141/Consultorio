# Configurações do Banco de Dados PostgreSQL
POSTGRES_PASSWORD=postgres123
POSTGRES_PORT=5432

# Configurações do Redis
REDIS_PORT=6379

# Configurações da Aplicação Consultório
APP_PORT=8080

# Dados da clínica (aparecem nos lembretes e na página de confirmação)
CLINICA_NOME=Consultório
CLINICA_URL_PUBLICA=http://localhost:8080
CLINICA_TELEFONE=
CLINICA_ENDERECO=

# Envio de lembretes por e-mail (SMTP). Deixe SMTP_HOST vazio para desativar.
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
